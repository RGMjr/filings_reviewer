# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to git (it's in .gitignore)

# Flask Configuration
# REQUIRED for production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In development, a random key is auto-generated if not set (sessions won't persist across restarts)
SECRET_KEY=
# Set to 'production' to enforce strict validation
APP_ENV=development

# API Authentication
# REQUIRED for production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In development, API key authentication is disabled by default
FILINGS_API_KEY=
# Set to 'true' to require API key authentication (always true in production)
API_KEY_REQUIRED=false

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# LLM Response Cache Configuration
# Cache reduces costs by storing and reusing identical LLM responses
LLM_CACHE_ENABLED=true
LLM_CACHE_PATH=data/llm_cache.db
# Bump cache version to invalidate all cached responses when prompts change
LLM_CACHE_VERSION=v1

# Database Configuration
# Local PostgreSQL connection strings
DATABASE_URL=postgresql://localhost/filings_analysis
TEST_DATABASE_URL=postgresql://localhost/filings_analysis_test

# GitHub Personal Access Token (for Claude Code MCP server)
# Generate at: https://github.com/settings/tokens
# Required scopes: repo, read:org
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_your-token-here

# Brave Search API Key (for Brave Search MCP server)
# Get your API key from: https://brave.com/search/api/
BRAVE_API_KEY=your-brave-api-key-here

# Google Gemini API Key (for Python Testing MCP server)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Financial Modeling Prep (FMP) API Key (for transcript ingestion)
# Get your API key from: https://financialmodelingprep.com/developer/docs/
# Required for: python3 scripts/ingest_transcripts.py --source fmp
FMP_API_KEY=your-fmp-api-key-here
