# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to git (it's in .gitignore)

# Flask Configuration
# REQUIRED for production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In development, a random key is auto-generated if not set (sessions won't persist across restarts)
SECRET_KEY=
# Set to 'production' to enforce strict validation
APP_ENV=development

# API Authentication
# REQUIRED for production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In development, API key authentication is disabled by default
FILINGS_API_KEY=
# Set to 'true' to require API key authentication (always true in production)
API_KEY_REQUIRED=false

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Google Gemini API key for the B2 vision provider (src/llm/providers/gemini.py).
# NOTE: this is DIFFERENT from GEMINI_API_KEY below which is consumed by the
# Python Testing MCP server. Google Vertex/AI Studio issues the same key value
# for both, but our Gemini vision adapter reads GOOGLE_API_KEY specifically.
GOOGLE_API_KEY=your-google-ai-studio-key

# Anthropic API key for the B2 vision provider (src/llm/providers/anthropic.py)
# and Claude-Sonnet-4-6 as the premium chart-reader in Wave B4 two-stage mode.
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ---- Wave B4 / B5 vision routing (optional) ---------------------------------
# Leave unset in dev for legacy single-call GPT-4o behavior. Set explicitly when
# running scripts/benchmark_vision.py bake-offs or when canarying a provider.
#
# VISION_PROVIDER=openai           # openai | gemini | anthropic (default: openai)
# VISION_MODEL_OCR=                # override per-provider default OCR model
# VISION_MODEL_CHART=              # override per-provider default chart model
# VISION_ROUTING_MODE=legacy       # legacy | two_stage (B4 task-aware routing)
# VISION_PROVIDER_OCR=             # two_stage: force the fast-OCR provider
# VISION_PROVIDER_CHART=           # two_stage: force the premium chart-read provider
#
# ---- PR 2: Per-site overrides for triage OCR (default: Gemini regardless of VISION_PROVIDER) ----
# VISION_PROVIDER_FULL_PAGE_OCR=gemini
# VISION_MODEL_FULL_PAGE_OCR=gemini-2.0-flash
# VISION_PROVIDER_PRESCAN=gemini
# VISION_MODEL_PRESCAN=gemini-2.0-flash
#
# ---- PR 3: Chart-read fallback escalation (default: Sonnet rescues low-conf Haiku) ----
# VISION_CHART_FALLBACK_MODEL=claude-sonnet-4-6
# VISION_CHART_FALLBACK_PROVIDER=anthropic
# VISION_CHART_CONFIDENCE_THRESHOLD=0.7
#
# Spend cap for the full bake-off sweep (scripts/benchmark_vision.py --bakeoff).
# Default is 15.0 USD. Harness aborts mid-sweep if cumulative spend crosses this.
# MAX_BAKEOFF_USD=15.0

# LLM Response Cache Configuration
# Cache reduces costs by storing and reusing identical LLM responses
# LLM cache uses DATABASE_URL (PostgreSQL) — no separate file path needed
LLM_CACHE_ENABLED=true
# Bump cache version to invalidate all cached responses when prompts change
LLM_CACHE_VERSION=v1

# Database Configuration
# Local PostgreSQL (Docker): postgresql://dev:dev@localhost:5433/filings_analysis
# Neon (production/cloud):   postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://localhost/filings_analysis
TEST_DATABASE_URL=postgresql://localhost/filings_analysis_test

# GitHub Personal Access Token (for Claude Code MCP server)
# Generate at: https://github.com/settings/tokens
# Required scopes: repo, read:org
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_your-token-here

# Brave Search API Key (for Brave Search MCP server)
# Get your API key from: https://brave.com/search/api/
BRAVE_API_KEY=your-brave-api-key-here

# Google Gemini API Key (for Python Testing MCP server)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Financial Modeling Prep (FMP) API Key (for transcript ingestion)
# Get your API key from: https://financialmodelingprep.com/developer/docs/
# Required for: python3 scripts/ingest_transcripts.py --source fmp
FMP_API_KEY=your-fmp-api-key-here

# V2 Pipeline Configuration
LOG_LEVEL=INFO
V2_WORKER_COUNT=4
V2_MIN_CONFIDENCE=0.5

# Image cache backing store (src/infra/image_storage.py)
#
# In local dev / tests: leave all R2_* unset; cache falls back to IMAGE_CACHE_DIR
# (defaults to <repo>/data/image_cache/ via src/infra/paths.py).
#
# In production / any environment with ephemeral filesystem: set all four R2_* vars
# below. When R2_BUCKET is set, the R2 backend is used exclusively — IMAGE_CACHE_DIR
# is ignored.
#
# IMAGE_CACHE_DIR=/path/to/persistent/image_cache
# R2_BUCKET=filings-reviewer-image-cache
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# Analytics / BI
#
# Target of the "Data Explorer" nav link in the Flask review UI. Defaults to the
# production Metabase service; override only if you self-host a second instance.
# METABASE_URL=https://filings-metabase.onrender.com

# Error Tracking (optional — uncomment to enable Sentry)
# SENTRY_DSN=https://...@sentry.io/...

# JSON structured logging (set to 1 for JSON output)
# JSON_LOGS=1
