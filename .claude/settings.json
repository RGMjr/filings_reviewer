{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(pytest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(mypy*)",
      "Bash(black*)",
      "Bash(ruff*)",
      "Bash(python3 -m src.gold_standard.v2_validator*)",
      "Bash(python3 scripts/sync_github_issues.py*)"
    ],
    "deny": [
      "Bash(rm -rf /)*",
      "Bash(sudo*)",
      "Bash(curl*|*bash)",
      "Bash(*> /etc/*)",
      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh pr merge*--admin*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cmd=\"${CLAUDE_TOOL_INPUT_command:-$1}\"; case \"$cmd\" in *\"git commit\"*) br=$(git -C \"$CLAUDE_PROJECT_DIR\" branch --show-current 2>/dev/null); if [ \"$br\" = \"main\" ] || [ \"$br\" = \"master\" ]; then echo \"BLOCKED: refusing to commit on $br. Use /commit-proj (auto-branches) or git checkout -b <branch> first.\" >&2; exit 2; fi ;; esac' _ \"$CLAUDE_TOOL_INPUT_command\""
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/precommit-simplify-check.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/stop-hook-git-check.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit.*metric_keywords",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\\n⚠️  REMINDER: metric_keywords.yaml changed.\\n   Before committing, run: python3 -m src.gold_standard.v2_validator\\n'"
          }
        ]
      },
      {
        "matcher": "(Edit|Write).*src/extraction",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\\n⚠️  REMINDER: extraction code changed.\\n   Before committing, run: python3 -m src.gold_standard.v2_validator\\n'"
          }
        ]
      },
      {
        "matcher": "(Edit|Write).*sql/",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\\n⚠️  REMINDER: sql/ changed.\\n   Verify: sequential numbering (no gaps/duplicates), FK refs only to earlier migrations, file registered in correct order.\\n'"
          }
        ]
      },
      {
        "matcher": "(Edit|Write).*\\.py",
        "hooks": [
          {
            "type": "command",
            "command": "ruff check --select=E,F --quiet src/ tests/ 2>&1 | head -20 || true"
          }
        ]
      }
    ]
  },
  "project": {
    "testCommand": "pytest",
    "lintCommand": "ruff check src/ tests/",
    "typeCheckCommand": "mypy src/review/ --strict",
    "coverageThreshold": 75
  }
}
