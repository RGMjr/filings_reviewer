{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(pytest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(mypy*)",
      "Bash(black*)",
      "Bash(ruff*)",
      "Bash(python3 scripts/validate_against_gold_standard.py*)",
      "Bash(python3 scripts/sync_github_issues.py*)"
    ],
    "deny": [
      "Bash(rm -rf /)*",
      "Bash(sudo*)",
      "Bash(curl*|*bash)",
      "Bash(*> /etc/*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/stop-hook-git-check.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'BLOCKED: You must run /plan-review before exiting plan mode. Run the plan-review skill now, then retry ExitPlanMode.'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit.*metric_keywords",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\\n⚠️  REMINDER: metric_keywords.yaml changed.\\n   Before committing, run: pytest -m gold_standard --gold-standard-mode=fresh -v\\n'"
          }
        ]
      },
      {
        "matcher": "(Edit|Write).*src/extraction",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\\n⚠️  REMINDER: extraction code changed.\\n   Before committing, run: pytest -m gold_standard --gold-standard-mode=fresh -v\\n'"
          }
        ]
      },
      {
        "matcher": "(Edit|Write).*sql/",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\\n⚠️  REMINDER: sql/ changed.\\n   Verify: sequential numbering (no gaps/duplicates), FK refs only to earlier migrations, file registered in correct order.\\n'"
          }
        ]
      },
      {
        "matcher": "(Edit|Write).*\\.py",
        "hooks": [
          {
            "type": "command",
            "command": "ruff check --select=E,F --quiet src/ tests/ 2>&1 | head -20 || true"
          }
        ]
      }
    ]
  },
  "project": {
    "testCommand": "pytest",
    "lintCommand": "ruff check src/ tests/",
    "typeCheckCommand": "mypy src/review/ --strict",
    "coverageThreshold": 75
  }
}
