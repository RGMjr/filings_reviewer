{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(pytest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(mypy*)",
      "Bash(ruff format*)",
      "Bash(ruff*)",
      "Bash(python3 scripts/validate_against_gold_standard.py*)",
      "Bash(python3 scripts/sync_github_issues.py*)",
      "Bash(bash scripts/extraction-change-workflow.sh*)"
    ],
    "deny": [
      "Bash(rm -rf /)*",
      "Bash(sudo*)",
      "Bash(curl*|*bash)",
      "Bash(*> /etc/*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/stop-hook-git-check.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m pytest tests/unit/ --collect-only -q 2>&1 | tail -5 && echo '\\nTest collection passed - safe to commit' || (echo '\\nTEST COLLECTION FAILED - fix before committing' && exit 1)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit.*metric_keywords",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\\n⚠️  REMINDER: metric_keywords.yaml changed.\\n   Before committing, run: pytest -m gold_standard --gold-standard-mode=fresh -v\\n'"
          }
        ]
      },
      {
        "matcher": "(Edit|Write).*\\.py$",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); file=$(echo \"$input\" | jq -r '.tool_input.file_path // empty'); [ -n \"$file\" ] && ruff format --quiet \"$file\" 2>/dev/null; exit 0"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"additionalContext\": \"PRESERVE: Current task goal, files being modified, test status, gold standard scores, and any uncommitted changes. Re-read ops/ITERATION_CONTEXT.md after compaction.\"}'"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "project": {
    "testCommand": "pytest",
    "lintCommand": "ruff check src/ tests/",
    "typeCheckCommand": "mypy src/review/ --strict",
    "coverageThreshold": 75
  }
}
