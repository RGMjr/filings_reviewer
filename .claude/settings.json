{
  "$schema": "https://claude.ai/schemas/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(pytest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(mypy*)",
      "Bash(black*)",
      "Bash(ruff*)",
      "Bash(python scripts/validate_against_gold_standard.py*)"
    ],
    "deny": [
      "Bash(rm -rf /)*",
      "Bash(sudo*)",
      "Bash(curl*|*bash)",
      "Bash(*> /etc/*)"
    ]
  },
  "preferences": {
    "defaultModel": "sonnet",
    "taskModels": {
      "planning": "opus",
      "implementation": "sonnet",
      "review": "opus"
    }
  },
  "project": {
    "testCommand": "pytest",
    "lintCommand": "ruff check src/ tests/",
    "typeCheckCommand": "mypy src/review/ --strict",
    "coverageThreshold": 75
  }
}
