{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(pytest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(mypy*)",
      "Bash(black*)",
      "Bash(ruff*)",
      "Bash(python scripts/validate_against_gold_standard.py*)",
      "Bash(python scripts/sync_github_issues.py*)"
    ],
    "deny": [
      "Bash(rm -rf /)*",
      "Bash(sudo*)",
      "Bash(curl*|*bash)",
      "Bash(*> /etc/*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/stop-hook-git-check.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit.*metric_keywords",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\\n⚠️  REMINDER: metric_keywords.yaml changed.\\n   Before committing, run: pytest -m gold_standard --gold-standard-mode=fresh -v\\n'"
          }
        ]
      }
    ]
  },
  "project": {
    "testCommand": "pytest",
    "lintCommand": "ruff check src/ tests/",
    "typeCheckCommand": "mypy src/review/ --strict",
    "coverageThreshold": 75
  }
}
